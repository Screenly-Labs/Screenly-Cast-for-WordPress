{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.2",
  "plugins": ["./screenly-cast"],
  "mappings": {
    "srly": "."
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "env": {
    "tests": {
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": false,
        "WP_ENVIRONMENT_TYPE": "local"
      }
    }
  }
}
